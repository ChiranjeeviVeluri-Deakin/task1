  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css"/>
</head>
<body>
  <div class="container">
    <header>
      <h1><%= title %></h1>
      <nav>
        <a class="btn" href="/" target="_blank">Health (GET /)</a>
